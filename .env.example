# Official DataHub MCP server (absolute path recommended).
CHANGEMARSHAL_DATAHUB_MCP_COMMAND=/absolute/path/to/.mcp-venv/bin/mcp-server-datahub
# Set only when the command needs arguments, as a non-empty JSON string array.
# CHANGEMARSHAL_DATAHUB_MCP_ARGS=["--transport","stdio"]

# Real DataHub connection inherited by the stdio MCP child.
DATAHUB_GMS_URL=http://127.0.0.1:8080
# DATAHUB_GMS_TOKEN=replace-with-a-real-token-when-auth-is-enabled

# Required official MCP feature gates for governed write-back.
TOOLS_IS_MUTATION_ENABLED=true
DATA_QUALITY_TOOLS_ENABLED=true
SAVE_DOCUMENT_TOOL_ENABLED=true
SAVE_DOCUMENT_RESTRICT_UPDATES=false

# Real GitHub execution surface. Never expose this token to the browser.
CHANGEMARSHAL_GITHUB_TOKEN=github-token-with-repository-permissions
CHANGEMARSHAL_GITHUB_REPOSITORY=owner/repository
CHANGEMARSHAL_GITHUB_PULL_NUMBER=123
# Required only by the gated live integration to verify the token identity.
CHANGEMARSHAL_GITHUB_ASSIGNEE=github-login

# Server-only configuration.
CHANGEMARSHAL_REPOSITORY_ROOT=/absolute/path/to/dbt-repository
CHANGEMARSHAL_CASE_REPLICA=.changemarshal/case.json
CHANGEMARSHAL_PORT=4100

# Optional browser operator session. Configure both values to require a signed,
# expiring HttpOnly session for the case and agent APIs; leave both unset for
# the existing local operator workflow.
# CHANGEMARSHAL_UI_PASSPHRASE=choose-a-strong-operator-passphrase
# CHANGEMARSHAL_UI_SESSION_SECRET=generate-a-long-random-signing-secret
# CHANGEMARSHAL_UI_SESSION_TTL_SECONDS=28800

# Real local QVAC orchestration. Managed mode uses the official provider and
# downloads the live-verified qwen3.6-27b model on first use. Override it only
# when the target hardware cannot sustain the verified 16K context.
CHANGEMARSHAL_QVAC_MODE=managed
CHANGEMARSHAL_QVAC_MODEL=qwen3.6-27b
CHANGEMARSHAL_QVAC_CONTEXT_SIZE=16384
CHANGEMARSHAL_QVAC_REASONING_BUDGET=0

# Enable the browser ToolLoopAgent only with a complete fixed scope. Empty
# owner mappings, validator commands, or artifacts remain fail-closed when the
# corresponding mutating tool is proposed.
CHANGEMARSHAL_AGENT_ENABLED=1
CHANGEMARSHAL_AGENT_REPOSITORY=owner/repository
CHANGEMARSHAL_AGENT_BASE_REF=BASE_SHA
CHANGEMARSHAL_AGENT_HEAD_REF=HEAD_SHA
CHANGEMARSHAL_AGENT_TARGET_URL=http://127.0.0.1:4100/
CHANGEMARSHAL_AGENT_MAX_HOPS=3
CHANGEMARSHAL_AGENT_OWNER_MAPPINGS_JSON=[["urn:li:corpuser:data-owner","github-login"]]
CHANGEMARSHAL_AGENT_VALIDATION_COMMAND_JSON=["dbt","test","--select","customers+"]
CHANGEMARSHAL_AGENT_ARTIFACT_PATHS_JSON=[".changemarshal/remediation/customers_compatibility.sql",".changemarshal/remediation/customers_compatibility.yml"]

# Optional non-authoritative AI SDK 7 coordination brief. Use a real
# OpenAI-compatible endpoint; deterministic policy and merge authority remain separate.
CHANGEMARSHAL_AI_BASE_URL=https://your-provider.example/v1
CHANGEMARSHAL_AI_API_KEY=provider-secret
CHANGEMARSHAL_AI_MODEL=provider-model-id

# Legacy CUTSET_* names are accepted only as migration aliases. If both prefixes
# are present, their values must be identical or startup fails closed.
